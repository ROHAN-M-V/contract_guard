# Contract Guard Backend Configuration
PROJECT_NAME="Contract Guard"
API_V1_STR="/api/v1"
ENVIRONMENT="development"

# Database
# For PostgreSQL: postgresql+psycopg2://postgres:postgres@localhost:5432/contract_guard
# For SQLite (local dev/test fallback): sqlite:///./contract_guard.db
DATABASE_URL=sqlite:///./contract_guard.db

# Optional Supabase Storage
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=contract-documents

# AI Service Integration
USE_MOCK_AI=true
AI_ANALYSIS_SERVICE_URL=http://localhost:8001
ALLOW_PUBLIC_REGISTRATION=false

# Security
SECRET_KEY=contract-guard-super-secret-key-change-in-production-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI model credentials stay on the backend and are never sent from the browser.
AI_MODEL_API_KEY=
